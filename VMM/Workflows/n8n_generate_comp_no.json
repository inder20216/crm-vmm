      "parameters": {
        "jsCode": "const allTokens = $input.all();\nconst sorted = allTokens.sort((a, b) => new Date(b.json.updated_at) - new Date(a.json.updated_at));\nconst latest = sorted[0].json;\nreturn [{ json: { token: latest.token, updated_at: latest.updated_at, expires_at: latest.expires_at } }];"
      },
