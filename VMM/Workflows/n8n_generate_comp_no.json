    },
    {
      "parameters": {
        "jsCode": "const token = $json.token;\n\nif (!token) {\n  return [{ json: { success: false, error: 'Token is missing' } }];\n}\n\ntry {\n  const response = await this.helpers.httpRequest({\n    method: 'POST',\n    url: 'https://vcrm.openmindservices.in/apis/complaint-no',\n    headers: {\n      'Authorization': `Bearer ${token}`,\n      'Content-Type': 'application/json'\n    },\n    json: true,\n    timeout: 8000\n  });\n\n  return [{ json: { success: true, complaintno: response.complaintno } }];\n\n} catch (error) {\n  return [{ json: { success: false, error: error.message } }];\n}"
      },
