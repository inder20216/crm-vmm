    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\n\n// Only open WIPs, sorted newest-replied first\nconst wips = rows\n  .filter(r => (r.status || '').toLowerCase() === 'open' && r.email_id)\n  .sort((a, b) => new Date(b.replied_at || b.received_at || 0) - new Date(a.replied_at || a.received_at || 0))\n  .map(r => ({\n    id:             r.email_id        || '',\n    conversationId: r.conversation_id || '',\n    subject:        r.subject         || '',\n    fromAddr:       r.from_addr       || '',\n    storeCode:      r.store_code      || '',\n    receivedAt:     r.received_at     || '',\n    repliedAt:      r.replied_at      || '',\n    savedBy:        r.saved_by        || '',\n    status:         'WIP',\n    parsed: (() => {\n      try { return typeof r.partial_fields === 'object' ? r.partial_fields : JSON.parse(r.partial_fields || '{}'); }\n      catch { return {}; }\n    })()\n  }));\n\nreturn [{ json: { success: true, wips } }];"
      },
